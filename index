function playSimpleMatch(box,a,b){

  const score=box.querySelector(".score");
  const button=box.querySelector("button");

  button.disabled=true;
  score.className="score live";
  score.textContent="MATCH LIVE";

  const events=document.createElement("div");
  box.appendChild(events);

  let minute=0;
  let ga=0;
  let gb=0;

  const timer=setInterval(()=>{

    minute+=10;

    const r=Math.random();

    if(r<scoreChance(a,b)*.7){
      ga=Math.min(16,ga+1);
      events.innerHTML+=`
        <div class="event">${minute}' ${a} scores!</div>
      `;
    }else if(
      r<
      scoreChance(a,b)*.7+
      scoreChance(b,a)*.7
    ){
      gb=Math.min(16,gb+1);
      events.innerHTML+=`
        <div class="event">${minute}' ${b} scores!</div>
      `;
    }else{
      events.innerHTML+=`
        <div class="event">${minute}' No goal.</div>
      `;
    }

    if(minute>=90){

      clearInterval(timer);

      if(ga===gb){

        if(canScore(a,b,true)&&canScore(b,a,true)){
          Math.random()<.5?ga++:gb++;
        }else if(canScore(a,b,true)){
          ga++;
        }else{
          gb++;
        }
      }

      score.className="score";
      score.textContent=`${ga} : ${gb}`;

      historyMatches.unshift({
        a,b,ga,gb,
        type:"Cup"
      });
    }

  },450);
}

