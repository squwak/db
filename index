function regionTeams(region,count){
  return regions[region]
    .slice()
    .sort((a,b)=>rankOf(a)-rankOf(b))
    .slice(0,count);
}

function getCupTeams(group,cup){
  if(cup==="National Champions Cup")
    return [
      ...regionTeams("Africa",10),
      ...regionTeams("South America",8),
      ...regionTeams("North America",10),
      ...regionTeams("Oceania",6),
      ...regionTeams("Asia",14),
      ...regionTeams("Europe",16)
    ];

  if(cup==="NCC 2")
    return ranking.slice(-16);

  if(cup==="Euro")
    return regionTeams("Europe",24);

  if(cup==="Asian Cup")
    return regionTeams("Asia",24);

  if(cup==="African Cup")
    return regionTeams("Africa",16);

  if(cup==="American Cup"){
    return [
      ...regionTeams("South America",6),
      ...regionTeams("North America",10)
    ];
  }

  return cups[group]?.[cup]||[];
}

/* =========================
   MATCH SIMULATION
========================= */

function canScore(country,opponent,penalty=false){
  const own=hasDolls(country);
  const opp=hasDolls(opponent);

  if(penalty)return hasDolls(country)||hasGK(country);

  if(own)return true;

  if(!opp && hasGK(country))return true;

  return false;
}

function scoreChance(country,opponent){
  if(!canScore(country,opponent,false))return 0;

  const s=strength(country);
  const g=hasGK(country);

  let chance=.08+s*.035;

  if(!hasDolls(opponent))chance+=.06;
  if(g && !hasDolls(country))chance=.045;

  return Math.min(.35,chance);
}

function goalCount(a,b){
  let goals=0;
  const ca=scoreChance(a,b);

  if(ca<=0)return 0;

  const strengthBonus=Math.min(1,strength(a)/10);

  for(let i=0;i<16;i++){
    let chance=ca*(.7+.3*strengthBonus);
    if(Math.random()<chance)goals++;
  }

  return Math.min(16,goals);
}

function simulateMatch(a,b,allowDraw=true){
  let ga=goalCount(a,b);
  let gb=goalCount(b,a);

  if(!allowDraw && ga===gb){
    const pa=canScore(a,b,true);
    const pb=canScore(b,a,true);

    if(pa||pb){
      if(pa&&pb){
        Math.random()<.5?ga++:gb++;
      }else if(pa){
        ga++;
      }else{
        gb++;
      }
    }
  }

  return {a,b,ga,gb};
}

