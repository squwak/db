function friendlyPage(){
  app.innerHTML=`
    <div class="card">
      <h2>Friendly Match</h2>
      <p class="small">Friendly matches do not change rankings.</p>

      <label>Team 1</label>
      <input id="fa" placeholder="Country">

      <label>Team 2</label>
      <input id="fb" placeholder="Country">

      <button onclick="startFriendly()">Start Match</button>
    </div>

    <div id="friendlyResult"></div>
  `;
}

function startFriendly(){
  const a=document.getElementById("fa").value.trim();
  const b=document.getElementById("fb").value.trim();

  if(!a||!b)return;

  const result=document.getElementById("friendlyResult");

  let ga=0,gb=0,minute=0;

  result.innerHTML=`
    <div class="card">
      <h3>${a} vs ${b}</h3>
      <div id="friendlyScore" class="score">0 : 0</div>
      <div id="friendlyEvents"></div>
    </div>
  `;

  const score=document.getElementById("friendlyScore");
  const events=document.getElementById("friendlyEvents");

  const timer=setInterval(()=>{
    minute+=5;

    const roll=Math.random();

    if(roll<scoreChance(a,b)*.55){
      ga=Math.min(16,ga+1);
      events.innerHTML+=`<div>${minute}' ${a} scores!</div>`;
    }else if(roll<scoreChance(a,b)*.55+scoreChance(b,a)*.55){
      gb=Math.min(16,gb+1);
      events.innerHTML+=`<div>${minute}' ${b} scores!</div>`;
    }else{
      events.innerHTML+=`<div>${minute}' No goal.</div>`;
    }

    score.textContent=`${ga} : ${gb}`;

    if(minute>=90){
      clearInterval(timer);
      events.innerHTML+=`<br><b>FULL TIME</b>`;

      historyMatches.unshift({
        a,b,ga,gb,
        type:"Friendly"
      });
    }
  },500);
}

