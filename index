function qualificationTeams(id){

  if(id==="ncc"){
    return [
      ...regions["Europe"].slice(),
      ...regions["Asia"].slice(),
      ...regions["Africa"].slice(),
      ...regions["North America"].slice(),
      ...regions["South America"].slice(),
      ...regions["Oceania"].slice()
    ];
  }

  if(id==="america"){
    return [
      ...regions["North America"],
      ...regions["South America"]
    ];
  }

  if(id==="euro")return regions["Europe"].slice();
  if(id==="asia")return regions["Asia"].slice();
  if(id==="africa")return regions["Africa"].slice();
  if(id==="oceania")return regions["Oceania"].slice();

  return [];
}

