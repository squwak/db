function startNCCKnockouts(){

  const qualified=[];

  for(let i=0;i<16;i++){
    const table=window.nccTournament.standings[i];

    if(table){
      qualified.push(table[0].name);
      qualified.push(table[1].name);
    }
  }

  window.nccKnockout={
    teams:qualified
  };

  showNCCKnockoutRound("Round of 32");
}

function showNCCKnockoutRound(title){

  const teams=window.nccKnockout.teams;

  if(teams.length===1){
    finishNCC(teams[0]);
    return;
  }

  let nextTitle="";

  if(teams.length===32)nextTitle="Round of 16";
  if(teams.length===16)nextTitle="Quarterfinals";
  if(teams.length===8)nextTitle="Semifinals";
  if(teams.length===4)nextTitle="Final";
  if(teams.length===2)nextTitle="Champion";

  app.innerHTML=`
    <button class="secondary" onclick="cupsPage()">← Exit NCC</button>

    <div class="card">
      <h2>NCC — ${title}</h2>
      <p>${teams.length} teams</p>
      <div id="koMatches"></div>
    </div>
  `;

  const box=document.getElementById("koMatches");

  const shuffled=teams.slice().sort(()=>Math.random()-.5);

  const winners=[];

  let finished=0;

  for(let i=0;i<shuffled.length;i+=2){

    const a=shuffled[i];
    const b=shuffled[i+1];

    const m=document.createElement("div");
    m.className="match";

    m.innerHTML=`
      <b>${a} vs ${b}</b>
      <div class="score">— : —</div>
      <button>Play Match</button>
    `;

    box.appendChild(m);

    m.querySelector("button").onclick=()=>{

      if(m.dataset.done)return;
      m.dataset.done="1";

      const score=m.querySelector(".score");
      const button=m.querySelector("button");

      button.disabled=true;
      score.className="score live";
      score.textContent="MATCH LIVE";

      let minute=0;
      let ga=0;
      let gb=0;

      const events=document.createElement("div");
      m.appendChild(events);

      const timer=setInterval(()=>{

        minute+=10;

        const r=Math.random();

        if(r<scoreChance(a,b)*.75){
          ga=Math.min(16,ga+1);
          events.innerHTML+=`
            <div class="event">${minute}' ${a} scores!</div>
          `;
        }else if(
          r<
          scoreChance(a,b)*.75+
          scoreChance(b,a)*.75
        ){
          gb=Math.min(16,gb+1);
          events.innerHTML+=`
            <div class="event">${minute}' ${b} scores!</div>
          `;
        }else{
          events.innerHTML+=`
            <div class="event">${minute}' No goal.</div>
          `;
        }

        if(minute>=90){

          clearInterval(timer);

          if(ga===gb){

            events.innerHTML+=`
              <div class="event"><b>Penalty shootout!</b></div>
            `;

            if(canScore(a,b,true)&&canScore(b,a,true)){
              Math.random()<.5?ga++:gb++;
            }else if(canScore(a,b,true)){
              ga++;
            }else{
              gb++;
            }
          }

          score.className="score";
          score.textContent=`${ga} : ${gb}`;

          const winner=ga>gb?a:b;

          winners.push(winner);

          events.innerHTML+=`
            <div class="event"><b>${winner} advances.</b></div>
          `;

          historyMatches.unshift({
            a,b,ga,gb,
            type:"NCC "+title
          });

          finished++;

          if(finished===Math.floor(shuffled.length/2)){

            window.nccKnockout.teams=winners;

            setTimeout(()=>{
              showNCCKnockoutRound(nextTitle);
            },700);
          }
        }

      },450);
    };
  }
}

