}

function playNCCQualMatch(region,places,a,b,box){

  if(box.dataset.done)return;
  box.dataset.done="1";

  const score=box.querySelector(".score");
  const button=box.querySelector("button");

  button.disabled=true;
  score.className="score live";
  score.textContent="MATCH LIVE";

  const events=document.createElement("div");
  box.appendChild(events);

  let minute=0;
  let ga=0;
  let gb=0;

  const timer=setInterval(()=>{
    minute+=10;

    const r=Math.random();

    if(r<scoreChance(a,b)*.75){
      ga=Math.min(16,ga+1);
      events.innerHTML+=`
        <div class="event">${minute}' ${a} scores!</div>
      `;
    }else if(
      r<
      scoreChance(a,b)*.75+
      scoreChance(b,a)*.75
    ){
      gb=Math.min(16,gb+1);
      events.innerHTML+=`
        <div class="event">${minute}' ${b} scores!</div>
      `;
    }else{
      events.innerHTML+=`
        <div class="event">${minute}' No goal.</div>
      `;
    }

    if(minute>=90){

      clearInterval(timer);

      if(ga===gb){
        if(canScore(a,b,true)&&canScore(b,a,true)){
          Math.random()<.5?ga++:gb++;
        }
      }

      score.className="score";
      score.textContent=`${ga} : ${gb}`;

      const winner=ga>gb?a:b;

      events.innerHTML+=`
        <div class="event"><b>${winner} wins.</b></div>
      `;

      window.nccQualData.results[region].push({
        a,b,ga,gb,winner
      });

      historyMatches.unshift({
        a,b,ga,gb,
        type:"NCC Qualification"
      });

      checkNCCRegionFinished(region,places);
    }

  },450);
}

function checkNCCRegionFinished(region,places){

  const results=window.nccQualData.results[region];

  const teams=window.nccQualData.tables[region].teams;

  /*
    Every team plays enough qualification matches to produce
    a ranking. For the browser version, once all displayed
    qualification matches are completed, the winners plus
    highest ranked remaining teams fill the continental slots.
  */

  const expected=Math.floor(teams.length/2);

  if(results.length<expected)return;

  const score={};

  teams.forEach(t=>{
    score[key(t)]={name:t,pts:0,gf:0,ga:0};
  });

  results.forEach(m=>{
    score[key(m.a)].gf+=m.ga;
    score[key(m.a)].ga+=m.gb;
    score[key(m.b)].gf+=m.gb;
    score[key(m.b)].ga+=m.ga;

    if(m.ga>m.gb){
      score[key(m.a)].pts+=3;
    }else if(m.gb>m.ga){
      score[key(m.b)].pts+=3;
    }else{
      score[key(m.a)].pts++;
      score[key(m.b)].pts++;
    }
  });

  const table=Object.values(score).sort((a,b)=>
    b.pts-a.pts ||
    (b.gf-b.ga)-(a.gf-a.ga) ||
    b.gf-a.gf ||
    rankOf(a.name)-rankOf(b.name)
  );

  const qualified=table.slice(0,places).map(x=>x.name);

  window.nccQualData.tables[region].qualified=qualified;
  window.nccQualData.finished++;

  showNCCQualificationProgress();
}

