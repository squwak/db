function openCup(group,cup){
  const teams=getCupTeams(group,cup);

  app.innerHTML=`
    <button class="secondary" onclick="cupsPage()">← Back</button>
    <div class="card">
      <h2>${cup}</h2>
      <p class="small">${teams.length} teams</p>
      <div id="cupMatches"></div>
    </div>
  `;

  const box=document.getElementById("cupMatches");

  if(!teams.length){
    box.innerHTML="<p>No teams available.</p>";
    return;
  }

  if(teams.length===1){
    box.innerHTML=`<div class="match">${teams[0]}</div>`;
    return;
  }

  let pairs=[];
  for(let i=0;i<teams.length;i+=2){
    if(teams[i+1])pairs.push([teams[i],teams[i+1]]);
  }

  box.innerHTML=pairs.map((p,i)=>`
    <div class="match" id="cm-${i}">
      <b>${p[0]} vs ${p[1]}</b>
      <div class="score">— : —</div>
      <button onclick="runCupMatch('${encodeURIComponent(p[0])}','${encodeURIComponent(p[1])}',${i})">
        Play Match
      </button>
    </div>
  `).join("");
}

function runCupMatch(a,b,i){
  a=decodeURIComponent(a);
  b=decodeURIComponent(b);

  const box=document.getElementById("cm-"+i);
  if(!box)return;

  box.innerHTML=`
    <b>${a} vs ${b}</b>
    <div class="score live">MATCH LIVE</div>
    <div id="events-${i}" class="small"></div>
  `;

  const events=document.getElementById("events-"+i);

  let step=0;
  let ga=0,gb=0;

  const timer=setInterval(()=>{
    step++;

    if(step<=12){
      const scorer=Math.random()<scoreChance(a,b) ? a :
                    Math.random()<scoreChance(b,a) ? b : null;

      if(scorer===a)ga++;
      if(scorer===b)gb++;

      events.innerHTML+=`<div>${step}' ${scorer?scorer+" scores!":"No goal."}</div>`;
    }else{
      clearInterval(timer);

      box.querySelector(".score").className="score";
      box.querySelector(".score").textContent=`${ga} : ${gb}`;

      historyMatches.unshift({
        a,b,ga,gb,
        type:"Cup"
      });
    }
  },450);
}

