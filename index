  `;

  const box=document.getElementById("groupMatches-"+index);

  const pairs=[];

  for(let i=0;i<4;i++){
    for(let j=i+1;j<4;j++){
      pairs.push([group[i],group[j]]);
    }
  }

  const table={};

  group.forEach(t=>{
    table[key(t)]={
      name:t,
      pts:0,
      gf:0,
      ga:0
    };
  });

  let finished=0;

  pairs.forEach((p,i)=>{

    const m=document.createElement("div");
    m.className="match";

    m.innerHTML=`
      <b>${p[0]} vs ${p[1]}</b>
      <div class="score">— : —</div>
      <button>Play Match</button>
    `;

    box.appendChild(m);

    m.querySelector("button").onclick=()=>{

      if(m.dataset.done)return;
      m.dataset.done="1";

      const score=m.querySelector(".score");
      const button=m.querySelector("button");

      button.disabled=true;
      score.className="score live";
      score.textContent="MATCH LIVE";

      let minute=0;
      let ga=0;
      let gb=0;

      const events=document.createElement("div");
      m.appendChild(events);

      const timer=setInterval(()=>{

        minute+=10;

        const r=Math.random();

        if(r<scoreChance(p[0],p[1])*.75){
          ga=Math.min(16,ga+1);
          events.innerHTML+=`
            <div class="event">${minute}' ${p[0]} scores!</div>
          `;
        }else if(
          r<
          scoreChance(p[0],p[1])*.75+
          scoreChance(p[1],p[0])*.75
        ){
          gb=Math.min(16,gb+1);
          events.innerHTML+=`
            <div class="event">${minute}' ${p[1]} scores!</div>
          `;
        }else{
          events.innerHTML+=`
            <div class="event">${minute}' No goal.</div>
          `;
        }

        if(minute>=90){

          clearInterval(timer);

          if(ga===gb){
            score.className="score";
            score.textContent=`${ga} : ${gb}`;
          }else{
            score.className="score";
            score.textContent=`${ga} : ${gb}`;
          }

          table[key(p[0])].gf+=ga;
          table[key(p[0])].ga+=gb;

          table[key(p[1])].gf+=gb;
          table[key(p[1])].ga+=ga;

          if(ga>gb){
            table[key(p[0])].pts+=3;
          }else if(gb>ga){
            table[key(p[1])].pts+=3;
          }else{
            table[key(p[0])].pts++;
            table[key(p[1])].pts++;
          }

          historyMatches.unshift({
            a:p[0],
            b:p[1],
            ga,
            gb,
            type:`NCC Group ${String.fromCharCode(65+index)}`
          });

          finished++;

          if(finished===pairs.length){
            finishNCCGroup(index,table);
          }
        }

      },450);
    };
  });
}

function finishNCCGroup(index,table){

  const standings=Object.values(table).sort((a,b)=>
    b.pts-a.pts||
    (b.gf-b.ga)-(a.gf-a.ga)||
    b.gf-a.gf||
    rankOf(a.name)-rankOf(b.name)
  );

  const resultBox=document.getElementById("group-result-"+index);

  resultBox.innerHTML+=`
    <div class="qualbox">
      <h4>Final Standings</h4>

      ${standings.map((t,i)=>`
        <div class="teamline">
          <span>
            ${i+1}. ${t.name}
          </span>

          <span>
            ${t.pts} pts
            ${
              i<2
              ?'<span class="qualified"> QUALIFIED</span>'
              :'<span class="eliminated"> OUT</span>'
            }
          </span>
        </div>
      `).join("")}
    </div>
  `;

  if(!window.nccTournament.standings[index]){
    window.nccTournament.standings[index]=standings;
  }

  const done=window.nccTournament.standings
    .filter(Boolean).length;

  if(done===16){
    setTimeout(startNCCKnockouts,700);
  }
}

