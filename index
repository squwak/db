function dollsOf(country){
  return dolls.filter(d=>same(d[1],country));
}

function hasDolls(country){
  return dollsOf(country).length>0;
}

function hasGK(country){
  return dollsOf(country).some(d=>d[2]==="gk");
}

function strength(country){
  const ds=dollsOf(country);
  if(!ds.length)return 0;
  return ds.reduce((a,d)=>a+d[3],0)/ds.length;
}

/* =========================================================
   SCORING
========================================================= */

/*
  IMPORTANT:
  - A team with dolls can score normally.
  - A team with ZERO dolls cannot score against a team
    that has dolls.
  - A team with ZERO dolls CAN score against another
    team with ZERO dolls.
  - A goalkeeper can score in penalties.
  - Penalties can decide a draw.
*/

function canScore(country,opponent,penalty=false){
  const own=hasDolls(country);
  const opp=hasDolls(opponent);

  if(penalty){
    return true;
  }

  if(own)return true;

  if(!opp)return true;

  return false;
}

function scoreChance(country,opponent){
  if(!canScore(country,opponent,false))return 0;

  const own=hasDolls(country);
  const opp=hasDolls(opponent);

  if(!own&&!opp){
    return .025;
  }

  if(!own&&opp){
    return 0;
  }

  const s=strength(country);

  let chance=.035+s*.021;

  if(!opp)chance+=.025;

  return Math.min(.20,chance);
}

